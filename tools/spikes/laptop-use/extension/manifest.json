{
  "manifest_version": 3,
  "name": "Halftime laptop minutes (spike)",
  "version": "0.1.0",
  "description": "Splits a Halftime session into your picked sites, other tabs, other apps and away. Halftime gets totals, never sites or URLs.",
  "key": "",
  "minimum_chrome_version": "116",
  "incognito": "not_allowed",
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["storage", "idle"],
  "optional_host_permissions": [
    "*://*.instagram.com/*",
    "*://*.tiktok.com/*",
    "*://*.youtube.com/*",
    "*://*.x.com/*",
    "*://*.twitter.com/*",
    "*://*.reddit.com/*",
    "*://*.facebook.com/*",
    "*://*.snapchat.com/*",
    "*://*.netflix.com/*",
    "*://*.twitch.tv/*",
    "*://*.pinterest.com/*",
    "*://*.discord.com/*"
  ],
  "externally_connectable": {
    "matches": ["https://halftime-study.vercel.app/*", "http://localhost/*", "http://127.0.0.1/*"]
  },
  "action": { "default_popup": "popup.html", "default_title": "Halftime laptop minutes" },
  "options_ui": { "page": "options.html", "open_in_tab": true }
}
